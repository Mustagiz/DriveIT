DATABASE_URL="postgresql://driveit:driveit_pass@localhost:5432/driveit_db?schema=public"
JWT_SECRET="rideshare_super_secure_jwt_secret_key_2026_change_in_production"
PORT=5050
NODE_ENV=development

# Google Places API (get from https://console.cloud.google.com)
GOOGLE_API_KEY=your_google_api_key_here

# Razorpay (get from https://dashboard.razorpay.com — free test account)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@driveit.in

# ── KYC & Identity Verification ─────────────────────────────────────────────
# 1. DigiLocker OAuth2 (Govt of India - API Setu: https://partners.apisetu.gov.in)
DIGILOCKER_CLIENT_ID=your_digilocker_client_id_here
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret_here
DIGILOCKER_REDIRECT_URI=http://localhost:5050/api/kyc/digilocker/callback

# 2. Surepass Sub-AUA / UIDAI Aadhaar OTP (https://surepass.io - 100 free sandbox calls)
SUREPASS_API_KEY=your_surepass_token_here

