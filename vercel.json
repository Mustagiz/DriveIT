{
  "version": 2,
  "buildCommand": "npm --prefix client install && npm --prefix server install && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!assets/|icons/|sw\\.js|manifest\\.json|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

